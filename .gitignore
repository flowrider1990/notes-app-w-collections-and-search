/supabase/.branches
/supabase/.temp

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# typescript
*.tsbuildinfo

# certificates / keys
*.pem

# OS clutter
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# editor clutter
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# vercel (unused — no deployment step)
.vercel

